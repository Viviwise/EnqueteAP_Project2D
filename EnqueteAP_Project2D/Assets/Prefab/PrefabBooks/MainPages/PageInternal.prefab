  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Blessure interne - muscles sains
    sentences:
    - "Tissus fermes, \xE9lastiques et bien irrigu\xE9s."
    - "Couleur rouge vif homog\xE8ne."
    - "Absence de l\xE9sions, de d\xE9chirures ou de rigidit\xE9 excessive."
    - "Bonne capacit\xE9 de contraction et de rel\xE2chement."
