  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: "Blessure interne - coeur endommag\xE9"
    sentences:
    - "Organe pr\xE9sentant des zones sombres ou violac\xE9es, parfois fibreuses."
    - "Parois irr\xE9guli\xE8res, amincies ou \xE9paissies de mani\xE8re anormale."
    - "Pr\xE9sence possible de l\xE9sions internes, caillots ou n\xE9croses partielles."
    - "Peut \xEAtre caus\xE9 par une maladie cardiaque, une intoxication, un traumatisme
      ou une surcharge prolong\xE9e."
