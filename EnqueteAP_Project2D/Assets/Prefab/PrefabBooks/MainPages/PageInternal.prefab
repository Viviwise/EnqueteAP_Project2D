  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: "Blessure interne - reins irrit\xE9s"
    sentences:
    - "Organes gonfl\xE9s, rouge\xE2tres et sensibles au toucher."
    - "Surface parfois irr\xE9guli\xE8re avec pr\xE9sence de zones inflammatoires."
    - "Peut s\u2019accompagner d\u2019une accumulation anormale de liquide."
    - "Souvent caus\xE9 par une intoxication, une infection ou une surcharge toxique."
