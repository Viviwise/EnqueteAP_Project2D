  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b92e8734b81c4a6cba8d6c23a45c3bff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Blessure interne - coeur sain
    sentences:
    - "Organe ferme, bien form\xE9 et sym\xE9trique."
    - "De couleur rouge fonc\xE9 homog\xE8ne, sans zones p\xE2les ni taches sombres."
    - "Les parois sont \xE9paisses et r\xE9guli\xE8res, les cavit\xE9s bien d\xE9finies."
    - "Absence de l\xE9sions, de d\xE9p\xF4ts ou de caillots."
    - "Montre une bonne oxyg\xE9nation et une activit\xE9 cardiaque normale."
