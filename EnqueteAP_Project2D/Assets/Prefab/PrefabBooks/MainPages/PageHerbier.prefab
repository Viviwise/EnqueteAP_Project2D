MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2368024620469532883}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b92e8734b81c4a6cba8d6c23a45c3bff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Herbier - Aconitum napellus
    sentences:
    - "Aconit napel est une esp\xE8ce de la famille des Ranunculaceae. Plante commune
      et v\xE9n\xE9r\xE9e dans les pays avec des collines. "
    - "Cette plante est fortement mortelle ! A ne consommer sous aucun pr\xE9texte
      : elle contient l\u2019aconitine, l\u2019un des alcalo\xEFdes v\xE9g\xE9taux
      les plus rapides et mortels connus."
    - "En cas de consommation, provoque engourdissement imm\xE9diat, troubles cardiaques
      s\xE9v\xE8res, paralysie respiratoire, mort possible en quelques heures car
      elle emp\xEAche de vomir. "
