  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b92e8734b81c4a6cba8d6c23a45c3bff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Herbier - Atropa belladonna
    sentences:
    - "Belladone est une esp\xE8ce de plantes de la famille des Solanaceae. Plante
      commune dans les pays chauds de bord de mer. "
    - "Cette plante produit des baies noires brillantes historiquement utilis\xE9es
      comme poison et cosm\xE9tique."
    - "En cas de consommation, provoque hallucinations, dilatation extr\xEAme des
      pupilles, tachycardie, confusion mentale."
