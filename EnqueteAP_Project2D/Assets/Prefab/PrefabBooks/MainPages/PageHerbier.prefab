  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Herbier - Manihot esculenta
    sentences:
    - 'Manioc amer est une plante de la famille des Euphorbiaceae. Plante des pays
      du Sud. '
    - "Cette plante est un aliment de base dans ces pays mais mortel s\u2019il est
      mal pr\xE9par\xE9."
    - "En cas de consommation, provoque la lib\xE9ration excessive de cyanure, \xE9touffement
      et convulsions."
