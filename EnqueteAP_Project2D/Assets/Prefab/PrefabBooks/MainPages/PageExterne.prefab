  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    name: Ecchymose
    sentences:
    - "Poche de sang situ\xE9e sur n'importe quelle partie de la peau. "
    - "En fonction du d\xE9lai, peut \xEAtre bleu/ violet jusqu\u2019\xE0 vert/ jaune.
      Produit douleurs et d\xE9mangeaisons lors de la cicatrisation. "
    - "Peut \xEAtre caus\xE9 par un choc ou traumatisme.  "
